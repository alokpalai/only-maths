# Only Maths — environment variables
# Phase 1 (Foundation): only what's needed to run the app locally.
# Auth, payments, and AI provider vars are added in their own phases (4, 12, 13)
# per CLAUDE.md scope discipline — do not add them ahead of time.

# MongoDB connection string (used by src/lib/db.ts, wired up fully in Phase 3)
MONGODB_URI=

# Public app URL, used for absolute links and metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
